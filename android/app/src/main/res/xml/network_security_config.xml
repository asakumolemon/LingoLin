<?xml version="1.0" encoding="utf-8"?>
<!-- 自托管服务通常为 http:// 内网地址，Android 9+ 默认禁止明文流量，这里显式放行 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
